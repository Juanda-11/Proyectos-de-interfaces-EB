# Puerto local del servidor
PORT=3001
# Orígenes permitidos (separados por comas). En producción: la URL del frontend en Vercel
CORS_ORIGINS=http://localhost:5173

# --- Autenticación ---
# Secreto para firmar las sesiones (mínimo 32 caracteres). OBLIGATORIO en producción.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Cuenta de demostración (siempre disponible, sin base de datos). Valores por defecto:
# DEMO_EMAIL=demo@hydrograph.ai
# DEMO_PASSWORD=Hydro2026!
# DEMO_HINT=false oculta las credenciales de /api/health; DEMO_ENABLED=false desactiva la cuenta
# Registro de cuentas persistente (opcional): base de datos Upstash Redis o Vercel KV
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- IA (opcional). Sin ninguna clave se usa el motor por reglas ---
# Gemini (nivel gratuito): crea la clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Alternativa: Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Fuerza un proveedor (gemini | anthropic | rules). Por defecto: Gemini > Anthropic > reglas
# AI_PROVIDER=gemini
